.center {
  text-align: center;
}

/* 邀请码：可点按复制，浅绿底与主操作区分 */
.invite-code {
  margin-top: 20rpx;
  padding: 16rpx 0;
  border-radius: var(--radius-sm);
  background: var(--color-primary-light);
  text-align: center;
  font-size: var(--font-sm);
  font-weight: bold;
  color: var(--color-primary);
  letter-spacing: 2rpx;
}

.wait-hint {
  margin-top: 16rpx;
  color: var(--color-text-hint);
  font-size: var(--font-sm);
}

/* 文字型操作入口 */
.entry-link {
  text-align: center;
  font-size: var(--font-sm);
  color: var(--color-primary);
  text-decoration: underline;
  padding: 16rpx 0;
}

.entry-link.danger-link {
  color: var(--color-danger);
}
