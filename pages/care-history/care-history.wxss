.history-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.history-head .section-title {
  margin-bottom: 0;
}

/* 日期选择：胶囊按钮，提示可点 */
.day-picker {
  padding: 12rpx 24rpx;
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-pill);
  font-size: var(--font-sm);
  color: var(--color-primary);
}

/* 与首页今日用药保持同一行结构 */
.care-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--color-border);
}

.care-row:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.care-main {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.care-name {
  font-size: var(--font-h2);
  color: var(--color-text);
}

.care-meta {
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--color-text-weak);
}
