/* 顶部重要提示条：透明底 + 红字，左侧固定标签 + 右侧滚动字幕 */
.alert-bar {
  display: flex;
  align-items: center;
  height: 80rpx;
  margin-bottom: 12rpx;
  background: transparent;
  overflow: hidden;
}

.alert-tag {
  flex-shrink: 0;
  height: 100%;
  line-height: 80rpx;
  margin-right: 16rpx;
  font-size: var(--font-xs);
  font-weight: bold;
  color: #C62828;
  animation: alert-tag-color 3s linear infinite;
}

/* 红、黄、蓝三色闪现，每种颜色停留 1 秒（成对关键帧实现硬切换，不渐变） */
@keyframes alert-tag-color {
  0%,
  33.33% {
    color: #C62828;
  }
  33.34%,
  66.66% {
    color: #F57F17;
  }
  66.67%,
  100% {
    color: #1565C0;
  }
}

.alert-viewport {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
}

/* padding-left 让文字从右侧外开始滚动，动画时长由页面按文案长度下发 */
.alert-track {
  display: inline-block;
  padding-left: 100%;
  font-size: var(--font-sm);
  color: var(--color-danger);
  animation-name: alert-marquee;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

@keyframes alert-marquee {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-100%);
  }
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 8rpx 32rpx;
}

.hero-actions {
  display: flex;
  align-items: center;
}

/* 设置入口：首页唯一的文字按钮 */
.hero-settings {
  min-width: 140rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-pill);
}

.hero-settings:active {
  background: var(--color-primary-light);
}

.hero-date {
  font-size: var(--font-sm);
  color: var(--color-text-weak);
}

/* 首页药品清单：同一卡片内多行，用细线分隔 */
.med-item {
  margin-top: 24rpx;
  padding-top: 24rpx;
}

.med-item + .med-item {
  border-top: 2rpx solid var(--color-border);
}

.next-time {
  font-size: var(--font-h2);
  font-weight: bold;
  color: var(--color-primary);
}

.next-hint {
  font-size: var(--font-sm);
  color: var(--color-text-weak);
  margin: 4rpx 0 12rpx;
}

.next-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
}

.next-row + .next-row {
  border-top: 2rpx solid var(--color-border);
}

.next-name {
  flex: 1;
  font-size: var(--font-h2);
  font-weight: bold;
}

.next-dose {
  font-size: var(--font-body);
  color: var(--color-text-weak);
}

/* 24 小时网格：每小时一个圆点，圆点下方的药名尽量短 */
.hours-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 8rpx -8rpx 0;
}

.hour-cell {
  width: 25%;
  box-sizing: border-box;
  padding: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hour-dot {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 50%;
  text-align: center;
  font-size: var(--font-sm);
  font-weight: bold;
}

/* 已服用用绿色，与「在服」标签保持同一语义 */
.dot-done {
  background: var(--color-primary);
  color: #FFFFFF;
}

/* 待服用用橙色实心，保证数字对比度 */
.dot-pending {
  background: var(--color-warn);
  color: #FFFFFF;
}

.dot-none {
  background: var(--color-placeholder);
  color: var(--color-text-hint);
}

.hour-meds {
  width: 100%;
  margin-top: 6rpx;
  text-align: center;
}

.hour-med {
  font-size: 26rpx;
  line-height: 1.3;
  color: var(--color-text);
}

.hours-legend {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
  font-size: var(--font-xs);
  color: var(--color-text-weak);
}

.legend-item {
  display: flex;
  align-items: center;
  margin: 0 12rpx;
}

.legend-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.banner {
  background: var(--color-warn-light);
  border: 2rpx solid var(--color-warn);
}

.banner-text {
  font-size: var(--font-sm);
  color: var(--color-warn);
  line-height: 1.5;
}

.link {
  font-size: var(--font-sm);
  color: var(--color-primary);
  text-decoration: underline;
}

/* ========== 身份选择（2.0） ========== */
.intro {
  padding: 48rpx 8rpx 32rpx;
}

.intro-title {
  font-size: var(--font-h1);
  font-weight: bold;
  letter-spacing: 2rpx;
}

.intro-sub {
  margin-top: 16rpx;
  font-size: var(--font-sm);
  color: var(--color-text-weak);
  line-height: 1.7;
}

.role-card {
  padding: 28rpx 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
  margin-bottom: 20rpx;
}

.role-card:active {
  background: var(--color-bg);
  border-color: var(--color-primary);
}

.role-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.role-title {
  font-size: var(--font-h2);
  font-weight: bold;
}

.role-text {
  margin-top: 12rpx;
  font-size: var(--font-sm);
  color: var(--color-text-weak);
  line-height: 1.6;
}

.wait-hint {
  margin-top: 16rpx;
  color: var(--color-text-hint);
  font-size: var(--font-sm);
}

/* 亲情绑定状态条：只呈现状态，操作统一在设置页 */
.bind-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  padding: 0 28rpx;
  margin-bottom: 24rpx;
  border-radius: var(--radius-card);
  background: var(--color-card);
}

.bind-bar-text {
  font-size: var(--font-sm);
  color: var(--color-text);
}

.bind-bar-idle {
  color: var(--color-text-hint);
}

.bind-bar-action {
  font-size: var(--font-xs);
  color: var(--color-primary);
}

/* 未授权提示：橙色块，避免与成功状态混淆 */
.warn-box {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: var(--radius-sm);
  background: var(--color-warn-light);
}

.warn-title {
  font-size: var(--font-sm);
  font-weight: bold;
  color: var(--color-warn);
}

.warn-text {
  margin-top: 8rpx;
  font-size: var(--font-xs);
  color: var(--color-warn);
}

/* 邀请码输入：长辈首页内直接填写，省去跳转 */
.code-input {
  margin-top: 24rpx;
  height: 112rpx;
  padding: 0 24rpx;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  font-size: var(--font-h1);
  font-weight: bold;
  letter-spacing: 12rpx;
  text-align: center;
}

/* 解除绑定：次要操作，弱化样式避免误触 */
.unbind-link {
  margin-top: 24rpx;
  padding: 12rpx 0;
  text-align: right;
  font-size: var(--font-sm);
  color: var(--color-text-hint);
  text-decoration: underline;
}

/* 邀请码：可点按复制，浅绿底与主操作区分 */
.invite-code {
  margin-top: 20rpx;
  padding: 16rpx 0;
  border-radius: var(--radius-sm);
  background: var(--color-primary-light);
  text-align: center;
  font-size: var(--font-sm);
  font-weight: bold;
  color: var(--color-primary);
  letter-spacing: 2rpx;
}

/* 副入口文字链接 */
.entry-link {
  text-align: center;
  font-size: var(--font-sm);
  color: var(--color-primary);
  text-decoration: underline;
  padding: 16rpx 0;
}

/* 今日用药：一行一次，右侧是确认按钮或状态 */
.care-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 2rpx solid var(--color-border);
}

.care-row:last-child {
  border-bottom: none;
  padding-bottom: 4rpx;
}

.care-main {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

/* 药名与「漏服」标签同一行，标签靠近药名不挤占右侧操作区 */
.care-head {
  display: flex;
  align-items: center;
}

.care-head .care-name {
  flex: 1;
  min-width: 0;
}

.care-head .tag {
  margin-left: 12rpx;
}

.care-name {
  font-size: var(--font-h2);
  color: var(--color-text);
}

.care-meta {
  margin-top: 6rpx;
  font-size: var(--font-sm);
  color: var(--color-text-weak);
}

.care-action {
  flex-shrink: 0;
  padding: 14rpx 32rpx;
  border-radius: var(--radius-pill);
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: var(--font-sm);
  font-weight: bold;
}

.care-action:active {
  background: var(--color-primary-dark);
}

.care-action.disabled {
  background: var(--color-border);
  color: var(--color-text-hint);
}

/* 库存不足 / 复诊临近：子女首页卡片内的橙色提示 */
.care-alerts {
  margin-bottom: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: var(--radius-sm);
  background: var(--color-warn-light);
}

.care-alert {
  font-size: var(--font-sm);
  color: var(--color-warn);
  line-height: 1.5;
}

.care-alert + .care-alert {
  margin-top: 8rpx;
}

/* 历史记录 / 周报入口：卡片底部两端对齐 */
.care-links {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}

.history-link {
  padding: 12rpx 0 4rpx;
  font-size: var(--font-sm);
  color: var(--color-primary);
  text-decoration: underline;
}
