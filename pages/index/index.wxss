/* 顶部重要提示条：透明底 + 红字，左侧固定标签 + 右侧滚动字幕 */
.alert-bar {
  display: flex;
  align-items: center;
  height: 80rpx;
  margin-bottom: 12rpx;
  background: transparent;
  overflow: hidden;
}

.alert-tag {
  flex-shrink: 0;
  height: 100%;
  line-height: 80rpx;
  margin-right: 16rpx;
  font-size: var(--font-xs);
  font-weight: bold;
  color: #C62828;
  animation: alert-tag-color 3s linear infinite;
}

/* 红、黄、蓝三色闪现，每种颜色停留 1 秒（成对关键帧实现硬切换，不渐变） */
@keyframes alert-tag-color {
  0%,
  33.33% {
    color: #C62828;
  }
  33.34%,
  66.66% {
    color: #F57F17;
  }
  66.67%,
  100% {
    color: #1565C0;
  }
}

.alert-viewport {
  flex: 1;
  overflow: hidden;
  white-space: nowrap;
}

/* padding-left 让文字从右侧外开始滚动，动画时长由页面按文案长度下发 */
.alert-track {
  display: inline-block;
  padding-left: 100%;
  font-size: var(--font-sm);
  color: var(--color-danger);
  animation-name: alert-marquee;
  animation-timing-function: linear;
  animation-iteration-count: infinite;
}

@keyframes alert-marquee {
  from {
    transform: translateX(0);
  }
  to {
    transform: translateX(-100%);
  }
}

.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 8rpx 32rpx;
}

.hero-settings {
  min-width: 140rpx;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--color-primary);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-pill);
}

.hero-settings:active {
  background: var(--color-primary-light);
}

.hero-date {
  font-size: var(--font-sm);
  color: var(--color-text-weak);
}

/* 首页药品清单：同一卡片内多行，用细线分隔 */
.med-item {
  margin-top: 24rpx;
  padding-top: 24rpx;
}

.med-item + .med-item {
  border-top: 2rpx solid var(--color-border);
}

.next-time {
  font-size: var(--font-h2);
  font-weight: bold;
  color: var(--color-primary);
}

.next-hint {
  font-size: var(--font-sm);
  color: var(--color-text-weak);
  margin: 4rpx 0 12rpx;
}

.next-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
}

.next-row + .next-row {
  border-top: 2rpx solid var(--color-border);
}

.next-name {
  flex: 1;
  font-size: var(--font-h2);
  font-weight: bold;
}

.next-dose {
  font-size: var(--font-body);
  color: var(--color-text-weak);
}

/* 24 小时网格：每小时一个圆点，圆点下方的药名尽量短 */
.hours-grid {
  display: flex;
  flex-wrap: wrap;
  margin: 8rpx -8rpx 0;
}

.hour-cell {
  width: 25%;
  box-sizing: border-box;
  padding: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.hour-dot {
  width: 72rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 50%;
  text-align: center;
  font-size: var(--font-sm);
  font-weight: bold;
}

/* 已服用用绿色，与「在服」标签保持同一语义 */
.dot-done {
  background: var(--color-primary);
  color: #FFFFFF;
}

/* 待服用用橙色实心，保证数字对比度 */
.dot-pending {
  background: var(--color-warn);
  color: #FFFFFF;
}

.dot-none {
  background: var(--color-placeholder);
  color: var(--color-text-hint);
}

.hour-meds {
  width: 100%;
  margin-top: 6rpx;
  text-align: center;
}

.hour-med {
  font-size: 26rpx;
  line-height: 1.3;
  color: var(--color-text);
}

.hours-legend {
  display: flex;
  justify-content: center;
  margin-top: 16rpx;
  font-size: var(--font-xs);
  color: var(--color-text-weak);
}

.legend-item {
  display: flex;
  align-items: center;
  margin: 0 12rpx;
}

.legend-dot {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  margin-right: 8rpx;
}

.banner {
  background: var(--color-warn-light);
  border: 2rpx solid var(--color-warn);
}

.banner-text {
  font-size: var(--font-sm);
  color: var(--color-warn);
  line-height: 1.5;
}

.link {
  font-size: var(--font-sm);
  color: var(--color-primary);
  text-decoration: underline;
}
