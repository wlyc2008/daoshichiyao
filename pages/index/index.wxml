<view class="page">
  <!-- 首次进入：选择使用身份 -->
  <block wx:if="{{!userRole}}">
    <view class="intro">
      <view class="intro-title">到时吃药</view>
      <view class="intro-sub">家人之间互相照护：子女登记药品与提醒，长辈按时收到提醒。</view>
    </view>

    <view class="card">
      <view class="section-title">请选择使用身份</view>

      <view class="role-card" hover-class="tap-hover" data-role="caregiver" bindtap="onChooseRole">
        <view class="role-head">
          <view class="role-title">我是子女</view>
          <view class="tag tag-done">管理者</view>
        </view>
        <view class="role-text">为父母登记药品、设置提醒时间，随时了解父母是否按时服药</view>
      </view>

      <view class="role-card" hover-class="tap-hover" data-role="caree" bindtap="onChooseRole">
        <view class="role-head">
          <view class="role-title">我是长辈</view>
          <view class="tag tag-pending">接收提醒</view>
        </view>
        <view class="role-text">收到家人发来的提醒后，按一下「已吃药」就行，不用自己设置</view>
      </view>
    </view>

    <view class="entry-link" bindtap="goBind">已有家人给的邀请码？点这里输入</view>
  </block>

  <!-- 长辈：等待家人发送关怀邀请 -->
  <block wx:elif="{{userRole === 'caree'}}">
    <view wx:if="{{!acked}}" class="hero">
      <view class="hero-date">{{today}}</view>
    </view>

    <view wx:if="{{bound}}" class="card">
      <!-- 已暂停：保留绑定，仅停掉推送 -->
      <block wx:if="{{notifyPaused}}">
        <view class="section-title">已暂停接收提醒</view>
        <view class="empty-text">家人设置的提醒不会再推送给您，随时可以恢复。</view>
        <button class="btn-primary" bindtap="onResume" disabled="{{binding}}">恢复接收</button>
        <view class="unbind-link" bindtap="onCareeUnbind">解除绑定</view>
      </block>

      <block wx:else>
        <view class="section-title">已开启家人的提醒</view>

        <view wx:if="{{notifyState !== 'accept'}}" class="warn-box">
          <view class="warn-title">{{notifyState === 'ban' ? '微信通知已被关闭' : '微信通知未开启'}}</view>
          <view wx:if="{{notifyState === 'ban'}}" class="warn-text">请点右上角「···」→ 设置 → 通知管理，打开「接收通知」。</view>
          <view wx:else class="warn-text">暂时收不到吃药提醒，开启后到时间微信才会提醒您。</view>
          <button class="btn-secondary" bindtap="onEnableNotify" disabled="{{binding}}">重新开启</button>
        </view>

        <view wx:if="{{!acked}}" class="empty-text">到时间微信会提醒您吃药，吃完按一下「已吃药」就好。</view>
        <view wx:else class="empty-text">已开启，到时微信会提醒您吃药。可以点击右上角圆点关闭小程序了。</view>

        <block wx:if="{{!acked}}">
          <button class="btn-primary" bindtap="onAck">我知道了</button>
          <view class="unbind-link" bindtap="onPause">暂停接收</view>
        </block>
      </block>
    </view>

    <!-- 今日用药：长辈只需点「已吃药」 -->
    <view wx:if="{{bound && !notifyPaused}}" class="card">
      <view class="section-title">今天的用药</view>

      <view wx:if="{{!careLoaded}}" class="empty-text">正在读取家人的安排…</view>
      <view wx:elif="{{careTotal === 0}}" class="empty-text">家人还没有设置今天的用药。</view>

      <block wx:else>
        <view class="summary">
          <view class="summary-main">今天 {{careDone}}/{{careTotal}} 次</view>
          <view class="summary-sub {{careDone === careTotal ? 'done' : ''}}">{{careDone === careTotal ? '今天的药都吃完了' : '还需 ' + (careTotal - careDone) + ' 次'}}</view>
        </view>

        <view wx:for="{{careItems}}" wx:key="key" class="care-row">
          <view class="care-main">
            <view class="care-head">
              <view class="care-name">{{item.medName}}</view>
              <view wx:if="{{item.missed && !item.taken}}" class="tag tag-danger">漏服</view>
            </view>
            <view class="care-meta">{{item.time}} · {{item.doseText}}</view>
          </view>
          <view wx:if="{{item.taken}}" class="tag tag-done">已吃药</view>
          <view
            wx:else
            class="care-action {{careConfirming === item.key ? 'disabled' : ''}}"
            hover-class="tap-hover"
            data-plan-id="{{item.planId}}"
            data-time="{{item.time}}"
            bindtap="onConfirmTaken"
          >{{careConfirming === item.key ? '记录中' : '已吃药'}}</view>
        </view>
      </block>
    </view>

    <view wx:else class="card">
      <view class="section-title">等待家人的提醒</view>
      <view class="empty-text">请让子女在小程序里点击「发送给父母」，把提醒卡片转发到您的微信。</view>
      <view class="empty-text wait-hint">卡片没收到也不要紧，直接输入子女告诉您的 6 位邀请码，同样可以开启。</view>

      <input
        class="code-input"
        type="text"
        value="{{typedCode}}"
        maxlength="6"
        placeholder="输入 6 位邀请码"
        bindinput="onCodeInput"
      />
      <view wx:if="{{bindError}}" class="wait-hint danger-text">{{bindError}}</view>

      <button class="btn-primary" bindtap="onConfirmBind" disabled="{{binding}}">
        {{binding ? '正在开启…' : '确认开启提醒'}}
      </button>
      <view class="privacy">开启时需要允许接收一次微信通知</view>
    </view>
  </block>

  <!-- 子女：原有首页 -->
  <block wx:else>
    <!-- 顶部重要提示：复诊倒计时 / 库存不足，滚动字幕 -->
    <view wx:if="{{alertText}}" class="alert-bar">
      <view class="alert-tag">重要提示</view>
      <view class="alert-viewport">
        <view class="alert-track" style="animation-duration: {{alertDuration}}s">{{alertText}}</view>
      </view>
    </view>

    <view class="hero">
      <view class="hero-date">{{today}}</view>
      <view class="hero-actions">
        <view class="hero-settings" hover-class="tap-hover" bindtap="goSettings">设置</view>
      </view>
    </view>

    <!-- 亲情绑定：首页只显示状态，操作统一在「设置」页 -->
    <view class="bind-bar" hover-class="tap-hover" bindtap="goSettings">
      <view class="bind-bar-text {{bound ? '' : 'bind-bar-idle'}}">{{bound ? bindStatusText : '尚未绑定长辈'}}</view>
      <view class="bind-bar-action">{{bound ? '查看' : '去设置'}}</view>
    </view>

    <!-- 长辈今日完成情况：只读，随时了解有没有按时吃药 -->
    <view wx:if="{{bound}}" class="card">
      <view class="section-title">长辈今天</view>

      <view wx:if="{{careAlerts.length}}" class="care-alerts">
        <view wx:for="{{careAlerts}}" wx:key="text" class="care-alert">{{item.text}}</view>
      </view>

      <view wx:if="{{!careLoaded}}" class="empty-text">正在读取…</view>
      <view wx:elif="{{careTotal === 0}}" class="empty-text">今天还没有用药安排。</view>

      <block wx:else>
        <view class="summary">
          <view class="summary-main">已服 {{careDone}}/{{careTotal}} 次</view>
          <view class="summary-sub {{careDone === careTotal ? 'done' : ''}}">{{careDone === careTotal ? '今天都吃完了' : '还需 ' + (careTotal - careDone) + ' 次'}}</view>
        </view>

        <view wx:for="{{careItems}}" wx:key="key" class="care-row">
          <view class="care-main">
            <view class="care-name">{{item.medName}}</view>
            <view class="care-meta">{{item.time}} · {{item.doseText}}</view>
          </view>
          <view class="tag {{item.taken ? 'tag-done' : (item.missed ? 'tag-danger' : 'tag-pending')}}">{{item.taken ? '已吃药' : (item.missed ? '漏服' : '待服用')}}</view>
        </view>
      </block>

      <view class="history-link" hover-class="tap-hover" bindtap="goCareHistory">查看历史记录</view>
    </view>

    <!-- 上块：用药清单 -->
    <view class="card">
      <view class="section-title">用药清单</view>

      <view wx:if="{{medsList.length === 0}}" class="empty-text">还没有添加药品，请到「设置」→「药品管理」中添加</view>

      <view
        wx:for="{{medsList}}"
        wx:key="id"
        class="med-item {{item.isActive === false ? 'inactive' : ''}}"
      >
        <view class="med-head">
          <view class="med-name">{{item.name}}</view>
          <view class="tag {{item.isActive === false ? 'tag-danger' : 'tag-done'}}">{{item.statusText}}</view>
        </view>
        <view class="med-meta">{{item.ruleText}} · 一日{{item.times}}次 · 每次 {{item.dose}}{{item.unit}}</view>
        <view class="med-meta {{item.needRefill ? 'danger-text' : ''}}">库存 {{item.remainingPills}} {{item.unit}}，可用 {{item.daysText}}</view>
      </view>
    </view>

    <!-- 中块：24小时服药 -->
    <view class="card">
      <view class="section-title">24小时服药</view>

      <view wx:if="{{todayTotal > 0}}" class="summary">
        <view class="summary-main">今天 {{todayDone}}/{{todayTotal}} 次</view>
        <view class="summary-sub {{allDone ? 'done' : ''}}">{{allDone ? '今天的药都吃完了' : '还需 ' + todayRemaining + ' 次'}}</view>
      </view>

      <view wx:if="{{todayTotal === 0}}" class="empty-text">添加药品后，这里会显示今天的服药安排</view>

      <block wx:else>
        <view class="hours-grid">
          <view wx:for="{{hours}}" wx:key="hour" class="hour-cell">
            <view class="hour-dot {{item.statusClass}}">{{item.hour}}</view>
            <view class="hour-meds">
              <view wx:for="{{item.names}}" wx:for-item="medName" wx:key="*this" class="hour-med">{{medName}}</view>
            </view>
          </view>
        </view>

        <view class="hours-legend">
          <view class="legend-item"><view class="legend-dot dot-done"></view>已服用</view>
          <view class="legend-item"><view class="legend-dot dot-pending"></view>待服用</view>
          <view class="legend-item"><view class="legend-dot dot-none"></view>无服药</view>
        </view>
      </block>
    </view>

    <!-- 下块：临期服药提醒 -->
    <view class="card">
      <view class="section-title">临期服药提醒</view>

      <view wx:if="{{nextDose.length === 0}}" class="empty-text">暂无后续服药安排</view>

      <block wx:else>
        <view class="next-time">{{nextDoseTime}}</view>
        <view class="next-hint">{{nextDoseHint}}</view>
        <view wx:for="{{nextDose}}" wx:key="medId" class="next-row">
          <view class="next-name">{{item.name}}</view>
          <view class="next-dose">{{item.doseText}}</view>
        </view>
      </block>
    </view>

    <view wx:if="{{hasMeds && (!icsExported || icsOutdated)}}" class="card banner">
      <view class="banner-text">{{icsOutdated ? '用药时间已变更，日历里的提醒还是旧时间' : '还没同步到手机日历，关掉微信后可能收不到提醒'}}</view>
      <view class="link" hover-class="tap-hover" bindtap="goSettings">{{icsOutdated ? '重新设置' : '去设置'}}</view>
    </view>

    <view class="privacy">照片与用药记录只保存在本机；微信提醒会同步到云端，仅用于发送提醒</view>
  </block>

  <dose-confirm-mask
    id="doseMask"
    visible="{{due ? true : false}}"
    name="{{due.name}}"
    dose="{{due.dose}}"
    unit="{{due.unit}}"
    timeText="{{due.timeText}}"
    bind:confirm="onConfirmDose"
    bind:snooze="onSnoozeDose"
  />
</view>
