<view class="page">
  <view class="group-title">亲情提醒</view>
  <view class="card">
    <block wx:if="{{!bound}}">
      <view class="empty-text">父母点开您分享的卡片，确认一次就能开始接收提醒，不用自己设置。</view>
      <button wx:if="{{inviteCode}}" class="btn-primary" open-type="share">发送给父母</button>
      <view wx:elif="{{inviteError}}" class="wait-hint danger-text" bindtap="onRetryInvite">{{inviteError}}，点此重试</view>
      <view wx:else class="wait-hint">正在准备邀请…</view>
      <view wx:if="{{inviteCode}}" class="invite-code" bindtap="onCopyCode">邀请码 {{inviteCode}} · 点此复制</view>
    </block>

    <block wx:else>
      <view class="bind-status">{{bindStatusText}}</view>
      <view wx:if="{{partnerPaused}}" class="empty-text">长辈暂时关掉了提醒，让其在小程序里点「恢复接收」即可。</view>
      <view wx:elif="{{partnerNotifyState !== 'accept'}}" class="empty-text">长辈还没允许微信通知，让其在小程序里点「重新开启」即可。</view>
      <view wx:else class="empty-text">长辈已能正常收到微信提醒。</view>
      <view class="unbind-link" bindtap="onUnbind">解除绑定</view>
    </block>
  </view>

  <view class="group-title">用药与提醒</view>
  <view class="card">
    <view class="entry" hover-class="tap-hover" data-url="/pages/med-manage/med-manage" bindtap="goPage">药品管理</view>
    <view class="entry" hover-class="tap-hover" data-url="/pages/plan-preview/plan-preview" bindtap="goPage">微信提醒</view>
    <view class="entry" hover-class="tap-hover" data-url="/pages/calendar-alert/calendar-alert" bindtap="goPage">设置日历提醒</view>
    <view class="entry" hover-class="tap-hover" bindtap="cancelCalendar">取消日历提醒</view>
  </view>

  <view class="group-title">健康档案</view>
  <view class="card">
    <view class="entry" hover-class="tap-hover" data-url="/pages/doc-archive/doc-archive" bindtap="goPage">医疗档案</view>
    <view class="entry" hover-class="tap-hover" data-url="/pages/logs/logs" bindtap="goPage">用药记录</view>
  </view>

  <view class="group-title">数据与云服务</view>
  <view class="card">
    <view class="entry" hover-class="tap-hover" bindtap="exportBackup">导出备份</view>
    <view class="entry" hover-class="tap-hover" bindtap="checkCloud">检查云端状态</view>
  </view>

  <view class="group-title">危险操作</view>
  <view class="card">
    <view class="entry danger" hover-class="tap-hover" bindtap="resetAll">还原初始状态</view>
  </view>

  <view class="app-footer">到时吃药 v{{version}}</view>
</view>
