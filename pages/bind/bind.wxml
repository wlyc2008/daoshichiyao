<view class="page">
  <block wx:if="{{state === 'input'}}">
    <view class="intro">
      <view class="intro-title">输入邀请码</view>
      <view class="intro-sub">请让子女把首页显示的 6 位邀请码告诉您。</view>
    </view>

    <view class="card">
      <input
        class="code-input"
        type="text"
        value="{{typedCode}}"
        maxlength="6"
        placeholder="6 位邀请码"
        bindinput="onCodeInput"
      />
      <button class="btn-primary" bindtap="onSubmitCode">下一步</button>
    </view>
  </block>

  <block wx:elif="{{state === 'ready'}}">
    <view class="intro">
      <view class="intro-title">家人为您开启了<br />用药提醒</view>
      <view class="intro-sub">点一次确认，之后到时间微信会提醒您吃药。</view>
    </view>

    <view class="card">
      <view class="section-title">确认后您将获得</view>
      <view class="benefit">· 到点微信提醒，手机响铃</view>
      <view class="benefit">· 吃完了按一下「已吃药」就行</view>
      <view class="benefit">· 不用自己设置任何时间</view>

      <button class="btn-primary" bindtap="onConfirm" disabled="{{submitting}}">
        {{submitting ? '正在开启…' : '确认开启提醒'}}
      </button>
      <view class="privacy">开启时需要允许接收一次微信通知</view>
    </view>
  </block>

  <block wx:elif="{{state === 'done'}}">
    <view class="intro">
      <view class="intro-title">已开启</view>
      <view class="intro-sub">家人已收到通知。到时间微信会提醒您，记得按「已吃药」。</view>
    </view>
    <view class="card">
      <button class="btn-primary" bindtap="goHome">知道了</button>
    </view>
  </block>

  <block wx:else>
    <!-- 自己打开自己的邀请：给出最醒目的指引 -->
    <view wx:if="{{errorCode === 'SELF_INVITE'}}" class="card alert-card">
      <view class="alert-head">
        <view class="alert-icon">!</view>
        <view class="alert-title">请让家人转发给您</view>
      </view>
      <view class="alert-text">这张卡片是您自己的微信生成的，用自己的微信打开无效。</view>
      <view class="alert-text">正确做法：让子女在首页点「发送给父母」，把卡片发到您的微信，再从聊天里点开。</view>
    </view>

    <view wx:else class="intro">
      <view class="intro-title">{{state === 'loading' ? '正在打开…' : '无法开启'}}</view>
      <view class="intro-sub">{{errorText || '请稍候'}}</view>
    </view>

    <view class="card">
      <button wx:if="{{errorCode !== 'SELF_INVITE'}}" class="btn-primary" bindtap="onReinput">重新输入邀请码</button>
      <button class="btn-secondary" bindtap="goHome">返回首页</button>
    </view>
  </block>
</view>
