<view class="page">
  <view wx:if="{{loading}}" class="card">
    <view class="empty-text">正在读取云端备份…</view>
  </view>

  <view wx:elif="{{!exists}}" class="card">
    <view class="section-title">还没有云端备份</view>
    <view class="empty-text">先在原手机的「设置」→「备份到云端」，换手机后回到这里即可恢复。</view>
  </view>

  <block wx:else>
    <view class="card">
      <view class="section-title">云端备份</view>

      <view class="info-row">
        <view class="info-label">备份时间</view>
        <view class="info-value">{{updatedAtText}}</view>
      </view>
      <view class="info-row">
        <view class="info-label">药品</view>
        <view class="info-value">{{counts.meds}} 种</view>
      </view>
      <view class="info-row">
        <view class="info-label">医疗档案</view>
        <view class="info-value">{{counts.docs}} 份</view>
      </view>
      <view class="info-row">
        <view class="info-label">用药记录</view>
        <view class="info-value">{{counts.logs}} 条</view>
      </view>

      <view class="notice notice-warn">照片和图片不会随备份恢复，换机后需要重新拍照。</view>

      <button class="btn-primary" bindtap="onRestore" disabled="{{restoring}}">
        {{restoring ? '正在恢复…' : '恢复到本机'}}
      </button>
    </view>
  </block>
</view>
