/* 表单字段、选项组、输入框已上收到 app.wxss，这里只保留页面专属样式 */
.mode-list {
  display: flex;
  flex-wrap: wrap;
  margin: 8rpx 0 16rpx;
}

.mode-item {
  width: calc(50% - 8rpx);
  margin: 0 16rpx 16rpx 0;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  box-sizing: border-box;
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-sm);
  font-size: var(--font-body);
  color: var(--color-text);
  background: #fff;
}

.mode-item:nth-child(2n) {
  margin-right: 0;
}

.mode-item.active {
  border-color: var(--color-primary);
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-weight: 600;
}

.hour-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.hour-cell {
  width: calc((100% - 60rpx) / 6);
  margin: 0 12rpx 12rpx 0;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: var(--radius-sm);
  background: var(--color-bg);
  color: var(--color-text);
  font-size: var(--font-sm);
}

.hour-cell:nth-child(6n) {
  margin-right: 0;
}

.hour-cell.active {
  background: var(--color-primary);
  color: #FFFFFF;
  font-weight: 600;
}

.custom-list {
  margin-top: 4rpx;
}

.custom-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}

.custom-row:last-child {
  border-bottom: none;
}

.custom-time {
  font-size: var(--font-body);
  color: var(--color-text);
}

.custom-del {
  padding: 8rpx 16rpx;
  font-size: var(--font-sm);
  color: var(--color-danger);
}

.preview {
  margin-top: 8rpx;
  padding: 20rpx 24rpx;
  border-radius: var(--radius-sm);
  background: var(--color-primary-light);
  color: var(--color-primary);
  font-size: var(--font-body);
  line-height: 1.5;
}

.unit-list {
  margin-top: 8rpx;
}

.intensity-hint {
  margin-top: 16rpx;
}

.photo {
  width: 100%;
  height: 360rpx;
  border-radius: var(--radius-sm);
  margin: 16rpx 0;
  background: var(--color-placeholder);
}
