.plan-row {
  min-height: 96rpx;
  line-height: 96rpx;
  font-size: var(--font-body);
  border-top: 2rpx solid var(--color-border);
}

.foot-links {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
}

.link {
  font-size: var(--font-sm);
  color: var(--color-primary);
  text-decoration: underline;
}

.cancel-link {
  margin-top: 24rpx;
  text-align: center;
  font-size: var(--font-sm);
  color: var(--color-primary);
  text-decoration: underline;
}
