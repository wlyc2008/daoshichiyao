.plan-row {
  min-height: 96rpx;
  line-height: 96rpx;
  font-size: var(--font-body);
  border-top: 2rpx solid var(--color-border);
}

.foot-links {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 24rpx;
}

.link {
  font-size: var(--font-sm);
  color: var(--color-primary);
  text-decoration: underline;
}

/* 仅开发者工具显示：模拟发送开关 */
.dev-simulate {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 2rpx solid var(--color-border);
}

.dev-simulate-text {
  font-size: var(--font-sm);
  color: var(--color-text-weak);
}
