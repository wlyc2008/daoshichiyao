<view class="page">
  <view class="card">
    <view class="section-title">今天的提醒时刻</view>
    <view wx:if="{{!hasMeds}}" class="empty">还没有药品，请先添加</view>
    <view wx:for="{{items}}" wx:key="text" class="plan-row">{{item.text}}</view>
    <view class="foot-links">
      <view class="link" hover-class="tap-hover" bindtap="goMealTimes">调整父母三餐时间</view>
      <view class="link" hover-class="tap-hover" bindtap="goRoutineTimes">调整父母起居时间</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">日历提醒</view>
    <view class="hint">到点响铃由父母手机的系统日历负责，关掉微信也能提醒。</view>

    <view class="steps">
      <view class="step">1. 点击下方按钮，在微信里选择父母的聊天发送日历文件</view>
      <view class="step">2. 提醒父母点开文件，选择「用其他应用打开」→ 日历</view>
      <view class="step">3. 建议导入到名为「到时吃药」的专用日历</view>
      <view class="step">4. 以后改时间或取消，删除该日历即可一次清空</view>
    </view>

    <view wx:if="{{exportedText}}" class="notice {{exportedStale ? 'notice-warn' : ''}}">{{exportedText}}</view>

    <button class="btn-primary" bindtap="exportCalendar">发送日历文件给父母</button>
    <button class="btn-secondary" bindtap="copyImportSteps">复制导入步骤发给父母</button>

    <view class="cancel-link" hover-class="tap-hover" bindtap="goCancel">父母如何取消日历提醒</view>
  </view>
</view>
