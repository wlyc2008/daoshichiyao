/* 选项组、输入框、信息行已上收到 app.wxss，这里只保留医疗档案专属样式 */
.date-btn {
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  font-size: var(--font-h2);
  color: var(--color-primary);
  background: var(--color-primary-light);
  border: 2rpx solid var(--color-primary);
  border-radius: var(--radius-sm);
}

.date-btn.empty {
  color: var(--color-text-weak);
  background: var(--color-card);
  border-color: var(--color-border);
}

.photo {
  width: 100%;
  height: 320rpx;
  border-radius: var(--radius-sm);
  margin: 16rpx 0;
  background: var(--color-placeholder);
}

.doc-item {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-top: 2rpx solid var(--color-border);
}

.doc-item:first-of-type {
  border-top: none;
}

.thumb {
  width: 160rpx;
  height: 160rpx;
  border-radius: var(--radius-sm);
  background: var(--color-placeholder);
  flex-shrink: 0;
}

.doc-info {
  flex: 1;
  padding: 0 16rpx;
}

.doc-title {
  font-size: var(--font-body);
  font-weight: bold;
}

.doc-meta {
  font-size: var(--font-sm);
  color: var(--color-text-weak);
  margin-top: 4rpx;
}

.doc-note {
  font-size: var(--font-sm);
  color: var(--color-text-weak);
  margin-top: 4rpx;
}

.doc-delete {
  font-size: var(--font-sm);
  color: var(--color-danger);
  padding: 8rpx 12rpx;
}
