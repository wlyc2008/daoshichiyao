<view class="page">
  <view class="card">
    <view class="section-title">今天的提醒时刻</view>
    <view wx:if="{{!hasMeds}}" class="empty">还没有药品，请先添加</view>
    <view wx:for="{{items}}" wx:key="text" class="plan-row">{{item.text}}</view>
    <view class="foot-links">
      <view class="link" hover-class="tap-hover" bindtap="goMealTimes">调整父母三餐时间</view>
      <view class="link" hover-class="tap-hover" bindtap="goRoutineTimes">调整父母起居时间</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">微信提醒</view>
    <view class="hint">提交后由云端按计划时间推送，只发送到父母手机。请先绑定父母，并让父母允许微信通知。</view>

    <view class="notice {{statusWarn ? 'notice-warn' : ''}}">{{statusText}}</view>

    <button class="btn-primary" bindtap="onOpenReminder" disabled="{{submitting}}">{{submitting ? '正在提交…' : '开启微信提醒'}}</button>
    <button class="btn-secondary" bindtap="copyGuide">复制开启步骤发给父母</button>
    <button class="btn-secondary" bindtap="goFamily">去亲情提醒查看绑定</button>
  </view>
</view>
