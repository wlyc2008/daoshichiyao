/* 全屏遮罩：淡入 + 内容轻微上浮，避免突然弹出吓到老人 */
@keyframes mask-fade-in {
  from {
    opacity: 0;
  }
  to {
    opacity: 1;
  }
}

@keyframes mask-panel-in {
  from {
    opacity: 0;
    transform: translateY(24rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.mask {
  position: fixed;
  left: 0;
  top: 0;
  z-index: 999;
  width: 100vw;
  height: 100vh;
  background: var(--color-card);
  display: flex;
  align-items: center;
  justify-content: center;
  animation: mask-fade-in 0.18s ease-out;
}

.mask-body {
  width: 100%;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
  text-align: center;
  animation: mask-panel-in 0.24s ease-out;
}

.mask-tip {
  font-size: var(--font-h2);
  color: var(--color-warn);
}

.mask-time {
  font-size: 60rpx;
  font-weight: bold;
  margin-top: 16rpx;
  color: var(--color-text);
}

.mask-name {
  font-size: 64rpx;
  font-weight: bold;
  margin-top: 32rpx;
  line-height: 1.3;
  color: var(--color-text);
}

.mask-dose {
  font-size: 44rpx;
  color: var(--color-text-weak);
  margin-top: 16rpx;
}

.mask-primary {
  margin-top: 72rpx;
  height: 132rpx;
  line-height: 132rpx;
  background: var(--color-primary);
  color: #FFFFFF;
  font-size: var(--font-h1);
  font-weight: bold;
  border-radius: var(--radius-card);
}

.mask-primary:active {
  background: var(--color-primary-dark);
}

.mask-secondary {
  margin-top: 24rpx;
  height: 120rpx;
  line-height: 120rpx;
  background: var(--color-card);
  color: var(--color-text-weak);
  font-size: var(--font-h2);
  border: 2rpx solid var(--color-border);
  border-radius: var(--radius-card);
}

.mask-secondary:active {
  background: var(--color-bg);
}

.mask-note {
  margin-top: 40rpx;
  font-size: var(--font-xs);
  color: var(--color-text-hint);
}
